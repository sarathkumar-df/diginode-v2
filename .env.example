# ── AI Provider Keys ──────────────────────────────────────────────────────────
# At least one is required. Users can also supply their own key via Settings.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your deployed frontend URL in production
FRONTEND_URL=http://localhost:5173

# ── Microsoft Entra ID (Azure AD) ─────────────────────────────────────────────
# Required for authentication in production.
# Get these from Azure Portal → App Registrations → your app
#
# AZURE_CLIENT_ID  → Application (client) ID
# AZURE_TENANT_ID  → Directory (tenant) ID
#                    Use 'common' to allow any Microsoft account (personal + work)
#                    Use 'organizations' for work/school accounts only
#                    Use your specific tenant GUID to restrict to one organisation
AZURE_CLIENT_ID=c2237a19-6adc-4ae2-836a-d177fc09bf7d
AZURE_TENANT_ID=411ff40d-6f49-43cd-9299-bc9ac5a52f48

# ── Auth bypass (local development only) ─────────────────────────────────────
# Set to 'true' to skip JWT verification in local dev.
# NEVER set this to true in production.
# SKIP_AUTH=true

# ── Neon DB (Phase 2) ─────────────────────────────────────────────────────────
# Required for map persistence. Get from Neon dashboard → Connection Details.
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Set to your deployed backend URL in production (leave empty for local dev)
# VITE_API_URL=https://your-backend.railway.app

# Azure client ID exposed to the frontend for MSAL configuration
# VITE_AZURE_CLIENT_ID=your_azure_client_id_here
# VITE_AZURE_TENANT_ID=common
